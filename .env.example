# GitOS Environment Configuration Template
# Copy this file to .env and populate with your own credentials

# ==========================================
# 1. GitHub API & OAuth Settings
# ==========================================
# GitHub Personal Access Token (classic or fine-grained) for server-side in-memory tree fetches
# Requires 'repo' and 'read:org' scope. Rate limit: 5,000 req/hr authenticated.
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# GitHub OAuth App credentials for Maintainer/Contributor login & permission auto-routing
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback/github

# ==========================================
# 2. FalkorDB Graph Database Configuration
# ==========================================
# Default connection settings for FalkorDB (RedisGraph successor)
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_MAX_CONNECTIONS=16
FALKORDB_CACHE_TTL_HOURS=72

# ==========================================
# 3. LLM Engine (Groq Cloud API)
# ==========================================
# Groq API Key for single-shot compressed subgraph reasoning (< 1000 tokens)
# Model target: llama-3.3-70b-versatile
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.1

# ==========================================
# 4. Service Ports & Runtime Environment
# ==========================================
ENVIRONMENT=development
LOG_LEVEL=info
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Strict Confirmation Mode: prevents unconsented bot actions
REQUIRE_EXPLICIT_CONFIRMATION=true
